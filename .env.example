# Set up Meta's WhatsApp Cloud API test number, then paste the values here.
# NEVER commit .env or paste real tokens into screenshots/AI prompts.
META_ACCESS_TOKEN=replace_with_meta_temporary_test_token
META_PHONE_NUMBER_ID=replace_with_phone_number_id
META_APP_SECRET=replace_with_app_secret_from_meta_app_settings
WEBHOOK_VERIFY_TOKEN=choose_a_long_random_webhook_verify_token
INTERNAL_API_KEY=choose_a_different_long_random_local_api_key
# International digits, no + sign. Only these recipients can be sent messages.
ALLOWED_TEST_RECIPIENTS=447000000001
GRAPH_VERSION=v26.0
DATABASE_PATH=runtime/integration.sqlite3
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=0.2
RETRY_MAX_SECONDS=5
# Optional: required only to run the LLM agent. Offline rule-based demo needs no key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
